<!DOCTYPE html>

<html>
	<%- include('headElement') %>
	<body>
		<%- include('header') %>
		<main class="flex-centered column view-height-75">
			<ul id="message-container" class="flex">
				<% for (let i = messages.length - 1; i >= 0; i--) { %>
					<li class="message flex column">
						<h3> <%= messages[i].user %> </h3>
						<p class="message-text"> <%= messages[i].text %> </p>
						<p class="message-date"> <%= messages[i].added.toLocaleString() %> </p>
					</li>
				<% } %>
			</ul>
			<form id="message-input" class="flex-centered" method="POST" action="/">
				<label class="flex" aria-label="name">
					<input id="input-name" type="text" name="name" placeholder="Name" />
				</label>
				<label class="flex grow-5" aria-label="message">
					<textarea id="input-text" class="grow-5" type="text" name="text" maxlength="1000" placeholder="Type your message here..."></textarea>
				</label>
				<button id="message-submit" class="grow">Submit</button>
			</form>
		</main>
	</body>
</html>
