<html>
	<body>
		<%- include('navbar') %>
		<h1><%= title %></h1>
		<ul>
			<% for (let i = 0; i < messages.length; i++) { %>
				<li>
					<h2> <%= messages[i].user %> </h2>
					<p> <%= messages[i].text %> </p>
					<p> <%= messages[i].added %> </p>
					<a href="/message/<%= messages[i].id %>">Details</a>
				</li>
			<% } %>
		</ul>
	</body>
</html>
